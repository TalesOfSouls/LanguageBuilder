version 2

/////////////////////////////////////////////////////////////////////////
// Global strings of the editor, English
//
// Used by the code (EDITOR_STR, @see models/localization/EditorLanguage.h)
// and by the layout/theme files ("text: @@key", @see cOMS/ui/UILayoutTxt.cpp)
//
// Syntax: "key: string" (@see cOMS/localization/Language.cpp)
//      \n = new line, quotes keep leading/trailing spaces
// WARNING: format strings must keep the format specifiers (%s, %l, %n, %d, %f2, ...) in the same order
//      %% = literal %
/////////////////////////////////////////////////////////////////////////

// General
edit_copy: Copy
edit_rename: Rename
edit_delete: Delete

// Scene2 test window (@see models/scenes/scene2.h)
